# Copy to .env and fill in. .env is git-ignored; never commit a real key.
#
# Google Maps Platform key. Enable these APIs for it in the Google Cloud console:
#   - Maps Static API       the satellite imagery that is analysed
#   - Maps JavaScript API   the interactive map in the web app
# Without a key, image upload still works.
GOOGLE_MAPS_KEY=

# Optional, only when the app is served to other machines (README: Keys and
# security): a separate browser key for the map (Maps JavaScript API only,
# restricted to your site's address), and the host names the service answers to.
# GOOGLE_MAPS_BROWSER_KEY=
# URBANSEG_ALLOWED_HOSTS=urbanseg.example.org

# Optional: the default model, v2 (October 2026) or v1 (August 2026); the web
# app can still choose per run. URBANSEG_GOLD=0 turns the gold-set editor off
# (e.g. on a public server: anyone who can open the app can save samples).
# URBANSEG_MODEL=v2
# URBANSEG_GOLD=0
